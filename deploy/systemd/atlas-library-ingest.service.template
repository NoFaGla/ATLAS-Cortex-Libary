# library-ingest (HTTP, kontrollierter Import). Läuft als Paperless-Dateibesitzer (HOST_UID), damit der Consume-Ordner lesbar ist.
[Unit]
Description=ATLAS M03 library-ingest (HTTP)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=@OPT@
Environment=PYTHONPATH=@OPT@/src PYTHONDONTWRITEBYTECODE=1
Environment=ATLAS_REGISTRY=@VAR@/registry/registry.sqlite3
Environment=ATLAS_STATE_DIR=@VAR@/registry/state
Environment=ATLAS_CONSUME_DIR=@SRV@/consume
Environment=ATLAS_PAPERLESS_URL=http://127.0.0.1:18000
Environment=ATLAS_INGEST_HOST=127.0.0.1
Environment=ATLAS_INGEST_PORT=18091
Environment=ATLAS_GPT_ENABLED=@GPT_ENABLED@
LoadCredential=ingest-token:@SEC@/library-ingest-token
LoadCredential=paperless-ingest-token:@SEC@/library-ingest-paperless-token
Environment=ATLAS_INGEST_TOKEN_FILE=%d/ingest-token
Environment=ATLAS_PAPERLESS_INGEST_TOKEN_FILE=%d/paperless-ingest-token
ExecStart=/usr/bin/python3 -m atlas_library.http_ingest
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0027
IPAddressDeny=any
IPAddressAllow=localhost
ReadWritePaths=@VAR@/registry @SRV@/consume
InaccessiblePaths=-@SEC@

[Install]
WantedBy=multi-user.target
