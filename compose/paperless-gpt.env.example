PAPERLESS_API_TOKEN=REPLACE_AFTER_CORE_START

# Wähle GENAU einen Provider.
LLM_PROVIDER=anthropic
LLM_MODEL=REPLACE_MODEL
ANTHROPIC_API_KEY=REPLACE_SECRET

# Alternativ:
# LLM_PROVIDER=openai
# LLM_MODEL=REPLACE_MODEL
